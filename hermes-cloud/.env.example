# Railway service Variables. Generate two independent keys, once.
OPENREEL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_PRIVATE_KEY_AT_LEAST_32_CHARS
OUTPUT_SIGNING_KEY=REPLACE_WITH_DIFFERENT_RANDOM_PRIVATE_KEY_AT_LEAST_32_CHARS
RENDER_LOCATION=cloud
DATA_DIR=/data
PORT=8080
# Set after Networking -> Generate Domain, no trailing slash.
PUBLIC_BASE_URL=https://YOUR_REAL_SERVICE.up.railway.app
# Exact HTTPS media hosts only. Redirect targets also need permission.
MEDIA_HOST_ALLOWLIST=storage.googleapis.com,*.googleusercontent.com
# Optional URL of the Vercel console; empty if only Hermes uses this service.
CORS_ORIGINS=https://YOUR_CONSOLE.vercel.app
MAX_JOB_SECONDS=900
MAX_MEDIA_BYTES=268435456
MAX_DATA_DISK_BYTES=8589934592
